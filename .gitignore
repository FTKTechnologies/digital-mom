# Dependencies and build leftovers
node_modules/
*.zip

# Brand source material (large, may contain private files). The site ships its own copies in site/assets/.
/assets/

# Local tooling
.claude/
.env
*.log

# Original project images (large). Optimised copies go to site/assets/work/.
/work-source/

# Loose reference images dropped in the project root
/WhatsApp*.jpeg

# Ready-to-upload zips
/upload/

# Team preview password hash and token (npm run preview-password). Goes only into the upload zips.
/preview-secret.json
/site/preview-config.php
